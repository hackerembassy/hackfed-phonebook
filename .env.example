FREEPBX_API_URL=https://freepbx.example.com/admin/api/api/gql

# https://freepbx.example.com/admin/config.php?display=api
# Applications | + Add Application | Machine-to-Machine app
# Allowed Scopes: gql:core:read
FREEPBX_CLIENT_ID="<client-id>"
FREEPBX_CLIENT_SECRET="<client-secret>"

FREEPBX_TLS_VERIFY=true

CACHE_TTL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
PORT=8080