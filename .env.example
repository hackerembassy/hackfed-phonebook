FREEPBX_API_URL=https://freepbx.example.com/admin/api/api/gql
FREEPBX_CLIENT_ID="<client-id>"
FREEPBX_CLIENT_SECRET="<client-secret>"
# Optional: defaults to the GraphQL URL with /gql replaced by /token.
# FREEPBX_TOKEN_URL=https://freepbx.example.com/admin/api/api/token
FREEPBX_SCOPE=gql:core:read
FREEPBX_TLS_VERIFY=true

CACHE_TTL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
PORT=8080